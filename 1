      "source": [
        "Проведите измерения для обоих наборов данных. Какова потеря в точности расстояния? Целесообразна ли для данной задачи высокая точность?\n",
        "Сравнения данных производить в %.\n"
      ],
      "metadata": {
        "id": "M-DliDfk-k2u"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. считаем расстояния для округленных данных (cities_l)\n",
        "# (для точных cities мы уже посчитали в df_distance_to_capitals)\n",
        "df_high = df_distance_to_capitals.copy() # Просто переименуем для удобства\n",
        "df_low = calculate_distances(cities_l)\n",
        "\n",
        "print(\"СРАВНЕНИЕ ТОЧНОСТИ (High vs Low)\")\n",
        "\n",
        "# 2. объединяем таблицы, чтобы сравнить строка к строке\n",
        "# (используем суффиксы _high и _low для колонок)\n",
        "merged = df_high.merge(df_low, on=\"Город\", suffixes=('_high', '_low'))\n",
        "\n",
        "# 3. считаем разницу в километрах\n",
        "merged['Diff_Country_km'] = (merged['Dist_Country_high'] - merged['Dist_Country_low']).abs()\n",
        "\n",
        "# 4. считаем разницу в процентах\n",
        "# разница / точное значение * 100\n",
        "merged['Error_Percent'] = (merged['Diff_Country_km'] / merged['Dist_Country_high']) * 100\n",
        "\n",
        "# 5. выводим статистику\n",
        "max_error_km = merged['Diff_Country_km'].max()\n",
        "avg_error_pct = merged['Error_Percent'].mean()\n",
        "max_error_pct = merged['Error_Percent'].max()\n",
        "\n",
        "print(f\"Максимальная ошибка (км): {max_error_km} км\")\n",
        "print(f\"Средняя ошибка (%):       {avg_error_pct} %\")\n",
        "print(f\"Максимальная ошибка (%):  {max_error_pct} %\")\n",
        "\n",
        "\n",
        "display(merged[['Город', 'Dist_Country_high', 'Dist_Country_low', 'Diff_Country_km', 'Error_Percent']])\n"
      ],
