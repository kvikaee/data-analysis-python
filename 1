        "# 1. сначала найдем столицы субъектов заранее, чтобы не искать их каждый раз внутри цикла\n",
        "subject_capitals_map = {}\n",
        "for city in cities:\n",
        "    if city.is_capital:\n",
        "        subject_capitals_map[city.subject] = city\n",
        "\n",
        "# 2. функция для расчета  расстояний\n",
        "def calculate_distances(city_list):\n",
        "    res = []\n",
        "    for city in city_list:\n",
        "        country_name = SUBJECT_MAPPING.get(city.subject, \"Неизвестно\")\n",
        "\n",
        "        # расстояние до столицы страны\n",
        "        if country_name in COUNTRY_CAPITALS:\n",
        "            cap = COUNTRY_CAPITALS[country_name]\n",
        "            dist_to_country_cap = haversine(\n",
        "                city.latitude, city.longitude,\n",
        "                cap[\"lat\"], cap[\"lon\"]\n",
        "            )\n",
        "\n",
        "\n",
        "        # расстояние до столицы субъекта\n",
        "        # берем из заранее подготовленного словаря\n",
        "        if city.subject in subject_capitals_map:\n",
        "            subj_cap_city = subject_capitals_map[city.subject]\n",
        "            # считаем, если это не тот же самый город\n",
        "            if subj_cap_city.name != city.name:\n",
        "                dist_to_subject_cap = haversine(\n",
        "                    city.latitude, city.longitude,\n",
        "                    subj_cap_city.latitude, subj_cap_city.longitude\n",
        "                )\n",
        "            else:\n",
        "                dist_to_subject_cap = 0.0\n",
        "\n",
        "        res.append({\n",
        "            \"Город\": city.name,\n",
        "            \"Субъект\": city.subject,\n",
        "            \"Dist_Country\": dist_to_country_cap,\n",
        "            \"Dist_Subject\": dist_to_subject_cap\n",
        "        })\n",
        "    return pd.DataFrame(res)\n",
        "\n",
        "\n",
        "df_distance_to_capitals = calculate_distances(cities)\n",
        "\n",
