      "cell_type": "code",
      "source": [
        "@dataclass\n",
        "class CitySmart: # Назовем так, чтобы отличалось\n",
        "    name: str\n",
        "    subject: str\n",
        "    latitude: float\n",
        "    longitude: float\n",
        "    timezone: str\n",
        "    sunrise: time\n",
        "    sunset: time\n",
        "    is_capital: bool\n",
        "    population_density: float\n",
        "\n",
        "    # защита\n",
        "    def __setattr__(self, key, value):\n",
        "        # список того, что менять нельзя\n",
        "        protected = ['name', 'latitude', 'longitude', 'subject', 'is_capital']\n",
        "\n",
        "        # если пытаемся поменять защищенное поле после создания\n",
        "        if key in protected and hasattr(self, key):\n",
        "            raise AttributeError(f\"Поле '{key}' защищено!\")\n",
        "\n",
        "        # менять можно\n",
        "        super().__setattr__(key, value)"
      ],
      "metadata": {
        "id": "WIPXgoynQ0EV"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def get_sun_times(city, on_date=datetime.date(2025, 10, 1)):\n",
        "\n",
        "    # извлекаем часовой пояс (UTC+3 -> 3)\n",
        "    offset = int(city.timezone.replace(\"UTC\", \"\"))\n",
        "\n",
        "    # создаем объект местоположения для astral\n",
        "    loc = LocationInfo(city.name, city.subject, \"UTC\", city.latitude, city.longitude)\n",
        "\n",
        "    # считаем восход/закат в UTC\n",
        "    s = sun(loc.observer, date=on_date)\n",
        "\n",
        "    # конвертируем в локальное время (добавляем смещение UTC)\n",
        "    sunrise = (s[\"sunrise\"] + datetime.timedelta(hours=offset)).strftime(\"%H:%M\")\n",
        "    sunset = (s[\"sunset\"] + datetime.timedelta(hours=offset)).strftime(\"%H:%M\")\n",
        "\n",
        "    return sunrise, sunset"
      ],
      "metadata": {
        "id": "wt3EnBkJUQ-2"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def update_times(city, on_date):\n",
        "\n",
        "    sunrise_str, sunset_str = get_sun_times(city, on_date)\n",
        "\n",
        "    # конвертируем строки в объекты time\n",
        "    sunrise_time = datetime.datetime.strptime(sunrise_str, \"%H:%M\").time()\n",
        "    sunset_time = datetime.datetime.strptime(sunset_str, \"%H:%M\").time()\n",
        "\n",
        "    # обновляем (эти поля РАЗРЕШЕНЫ для изменения в CitySmart)\n",
        "    city.sunrise = sunrise_time\n",
        "    city.sunset = sunset_time\n",
        "\n",
        "    return sunrise_time, sunset_time\n"
      ],
