        "COUNTRY_CAPITALS = {\n",
        "    \"Россия\":    {\"name\": \"Москва\", \"lat\": 55.7558, \"lon\": 37.6173},\n",
        "    \"Германия\":  {\"name\": \"Берлин\", \"lat\": 52.5200, \"lon\": 13.4050},\n",
