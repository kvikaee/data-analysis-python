        "}\n",
        "\n",
        "SUBJECT_MAPPING = {\n",
        "    \"Республика Коми\": \"Россия\",\n",
        "    \"Бавария\":         \"Германия\",\n",
        "    \"Цюрих (кантон)\":  \"Швейцария\",\n",
